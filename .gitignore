# =============================================================================
# Environment & Sensitive Credentials (NEVER COMMIT)
# =============================================================================
.env
.env.*
*.env
!.env.example

# =============================================================================
# Python Artifacts & Caches
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# =============================================================================
# Node & Frontend (Angular)
# =============================================================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.angular/cache/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Runtime Data & Generated Pipeline Artifacts
# =============================================================================
*.bak
data/ingestion_storage/*
!data/ingestion_storage/.gitkeep
data/quarantined_batches/*
!data/quarantined_batches/.gitkeep
data/batch_results/*
!data/batch_results/.gitkeep
data/sla_metrics/*
!data/sla_metrics/.gitkeep
File-Gen Scripts/OutPut/

# =============================================================================
# Operating System & IDEs
# =============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
