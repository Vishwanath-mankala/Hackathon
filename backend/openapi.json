          },
          "split_by": {
            "type": "string",
            "enum": [
              "size",
              "date"
            ],
            "title": "Split By",
            "description": "'size' or 'date'",
            "default": "size"
          },
          "batch_size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Batch Size",
            "description": "Rows per batch if split_by='size'",
            "default": 500
          },
          "out_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Out Dir",
            "description": "Custom output directory"
          }
        },
        "type": "object",
        "title": "Body_split_feed_api_feed_split_post"
      },
      "CheckDetail": {
