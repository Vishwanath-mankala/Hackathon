{
  "openapi": "3.1.0",
  "info": {
    "title": "Reconciliation & Feed Processing API",
    "description": "Production-ready FastAPI REST API backend wrapping feed generation, structural gating, tiered rule engine reconciliation, and diagnostics.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/feed/split": {
      "post": {
        "tags": [
          "Feed Ingestion & Batching"
        ],
        "summary": "Split Recon Source File",
        "description": "Splits a raw recon export into internal cache (cache_gl_cashbook.csv) and sequential ingestion batches with a declared manifest. Accepts either a file upload or a server-local file path.",
        "operationId": "split_feed_api_feed_split_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_split_feed_api_feed_split_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SplitReconResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/feed/manifest": {
      "get": {
        "tags": [
          "Feed Ingestion & Batching"
        ],
        "summary": "Get Ingestion Manifest",
        "description": "Reads and parses manifest.csv detailing sequence, row counts, and control totals for all batches.",
        "operationId": "get_manifest_api_feed_manifest_get",
        "parameters": [
          {
            "name": "manifest_path",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional custom manifest path",
              "title": "Manifest Path"
            },
            "description": "Optional custom manifest path"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManifestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
