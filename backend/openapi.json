  "components": {
    "schemas": {
      "AmbiguityDiagnosisRequest": {
        "properties": {
          "results_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Results Dir",
            "description": "Path to recon_results directory containing ambiguous_matches_for_review.csv. Defaults to config."
          }
        },
        "type": "object",
        "title": "AmbiguityDiagnosisRequest"
      },
      "AmbiguityDiagnosisResponse": {
        "properties": {
          "total_ambiguous": {
            "type": "integer",
            "title": "Total Ambiguous"
          },
          "avg_candidates": {
            "type": "number",
            "title": "Avg Candidates"
          },
          "max_candidates": {
            "type": "integer",
            "title": "Max Candidates"
          },
          "ambiguity_by_tier": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Ambiguity By Tier"
          },
          "resolved_by_reference": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved By Reference"
          },
          "resolved_by_reference_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved By Reference Pct"
          },
          "top_accounts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Top Accounts"
          },
          "top_amounts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Top Amounts"
          },
          "top_amounts_concentration_pct": {
            "type": "number",
            "title": "Top Amounts Concentration Pct"
          },
          "is_concentrated": {
            "type": "boolean",
            "title": "Is Concentrated"
          },
          "diagnostic_assessment": {
            "type": "string",
            "title": "Diagnostic Assessment"
          },
          "output_detail_csv": {
            "type": "string",
            "title": "Output Detail Csv"
          }
        },
        "type": "object",
        "required": [
          "total_ambiguous",
          "avg_candidates",
          "max_candidates",
          "ambiguity_by_tier",
          "top_accounts",
          "top_amounts",
          "top_amounts_concentration_pct",
          "is_concentrated",
          "diagnostic_assessment",
          "output_detail_csv"
        ],
        "title": "AmbiguityDiagnosisResponse"
      },
      "BatchesListResponse": {
        "properties": {
          "batches_dir": {
            "type": "string",
            "title": "Batches Dir"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "batches_dir",
          "count",
          "files"
        ],
        "title": "BatchesListResponse"
      },
      "Body_split_feed_api_feed_split_post": {
        "properties": {
          "file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "File",
            "description": "Recon CSV file upload"
          },
          "input_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
