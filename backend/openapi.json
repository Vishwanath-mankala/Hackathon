    },
    "/api/diagnostics/corrupt-batch": {
      "post": {
        "tags": [
          "Diagnostics & Simulation"
        ],
        "summary": "Simulate Batch Corruption (Chaos Testing)",
        "description": "Injects a realistic real-world failure into a batch file to test structural gate enforcement. Modes include: truncate, dropped_row, duplicate_row, tampered_amount, missing_column, bad_encoding. Automatically creates a .bak backup.",
        "operationId": "corrupt_batch_api_diagnostics_corrupt_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
