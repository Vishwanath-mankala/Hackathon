# =============================================================================
# Reconciliation & Feed Processing API — Configuration
# =============================================================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# =============================================================================
# Agent Platform Integration (CrewAI / Multi-Agent Platform API)
# =============================================================================
# Set to true to route anomaly scoring & auto-remediation to your CrewAI agents
CREWAI_ENABLED=false

# The REST API endpoint exposed by your CrewAI platform
# Supports both raw file input (/analyze-file) and structured anomaly input (/score-anomalies)
CREWAI_API_URL=http://localhost:8001/api/crew/analyze

# Bearer token or API key for your CrewAI platform (if secured)
CREWAI_API_KEY=your_crewai_api_key_here

# Request timeout in seconds
CREWAI_TIMEOUT_SECONDS=30.0

