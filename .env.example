# =============================================================================
# Bank Reconciliation Console & Agentic Pipeline — configuration TEMPLATE
#
# Copy this file to `.env` IN THIS DIRECTORY (the repo root).
#
# This is the ONLY configuration file in the repository. The backend reads it
# directly; the Angular app reads it at build time via
# frontend/scripts/generate-env.mjs. A copy anywhere else — backend/.env, or one
# relative to wherever you launched from — is ignored, and the API logs a
# warning if it finds one.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Base URL the browser uses to reach this API. Leave blank to derive it from
# HOST/PORT above (0.0.0.0 is a bind address, so it resolves to localhost).
# Set it explicitly when the API is served from another host or behind a proxy.
API_BASE_URL=

# -----------------------------------------------------------------------------
# Agent platform (CrewAI / Aava AI)
# -----------------------------------------------------------------------------
CREWAI_ENABLED=false

# Agent execution submission endpoint (POST, multipart with a zipped artefact)
CREWAI_API_URL=https://int-ai.aava.ai/agents/execute/agent-executions

# Execution output retrieval endpoint (GET ?execution_id=...)
CREWAI_RETRIEVAL_URL=https://int-ai.aava.ai/agents/execute/history/execution

# Bearer JWT for the agent platform
CREWAI_API_KEY=

CREWAI_WORKFLOW_ID=reconciliation-multiagent-flow
CREWAI_TIMEOUT_SECONDS=60.0

# -----------------------------------------------------------------------------
# Agent IDs
#
# Leave blank until you have created the agent on the platform and copied its ID
# from the agent's page. There are no defaults: an ID cannot be guessed, and a
# wrong one submits your batch data to somebody else's agent. A stage with a
# blank ID is reported as SKIPPED (not configured) and the deterministic local
# pipeline result stands, so an unconfigured deployment still runs end to end.
#
# See AGENTS.md for the prompt to configure each agent with.
# -----------------------------------------------------------------------------

# Fallback used when a stage has no ID of its own
CREWAI_AGENT_ID=

# Stage 1: Processing-time forecast, issued at ingest from the batch's size and
# the run history of comparable batches (see AGENTS.md "Forecast agent")
CREWAI_AGENT_FORECAST_ID=

# Stage 4: Anomaly classification & severity scoring
CREWAI_AGENT_ANOMALY_ID=

# Stage 6: Reconciliation & exception verification
CREWAI_AGENT_RECON_ID=

# Stage 7: SLA prediction & urgency classification
CREWAI_AGENT_SLA_ID=

# Stage 1: Ingestion & statement data extraction (manual dispatch only)
CREWAI_AGENT_EXTRACTION_ID=

# Non-pipeline developer collab agent (never dispatched by the orchestrator)
CREWAI_AGENT_COLLAB_ID=

# -----------------------------------------------------------------------------
# Pipeline automation
# -----------------------------------------------------------------------------
# Fire the Stage 4 / 6 / 7 agents automatically as their input artefacts are
# produced. Set false to run the deterministic pipeline only; the console can
# still dispatch an agent manually per stage.
AUTO_AGENT_DISPATCH=true

# Ingest every statement waiting in incoming_sftp/ when the API starts
# (ARCHITECTURE.md Stage 1 automated directory polling). Picked-up files are
# moved to incoming_sftp/processed/ so a restart does not re-ingest them. An
# empty dropbox means an empty console — nothing is ever seeded.
SFTP_AUTO_INGEST=true

# -----------------------------------------------------------------------------
# Processing-time calibration & forecast
#
# The estimator derives its throughput and per-escalation queue wait from the
# run history once enough runs of a meaningful size exist. Defaults are fine;
# they are listed so a deployment can tune them without a code change.
# -----------------------------------------------------------------------------
# Eligible runs needed before HISTORY replaces the formula's DEFAULT constants
CALIBRATION_MIN_RUNS=5
# Runs smaller than this sit on the formula's floors and carry no timing signal
CALIBRATION_MIN_RECORDS=200
# Most recent eligible runs considered
CALIBRATION_WINDOW=50
# Rows of history bundled for the forecast agent with each batch
FORECAST_HISTORY_ROWS=60
# Server-side poll for the forecast result: interval (s) and attempts (~15 min)
FORECAST_POLL_SECONDS=10
FORECAST_POLL_MAX_ATTEMPTS=90

# -----------------------------------------------------------------------------
# Deployment
#
# Every data directory below defaults to a path under the repo. When the API is
# deployed, point them at PERSISTENT storage (a mounted volume): the run history
# is the knowledge base the estimator and the forecast agent learn from, and an
# ephemeral container filesystem starts it cold on every restart.
#
# Run ONE API process. The batch registry, orchestrator and history are
# in-memory with a file behind them; multiple workers or replicas would split
# batches across processes and interleave history writes.
# -----------------------------------------------------------------------------
# DB_PATH=/mnt/recon-data/recon.db
# WORKING_FRAMES_DIR=/mnt/recon-data/working_frames
# FORECAST_DIR=/mnt/recon-data/forecasts
# SLA_METRICS_DIR=/mnt/recon-data/sla_metrics
# BATCH_RESULTS_DIR=/mnt/recon-data/batch_results
# INGESTION_STORAGE_DIR=/mnt/recon-data/ingestion_storage
# QUARANTINE_DIR=/mnt/recon-data/quarantined_batches
# ANOMALIES_DIR=/mnt/recon-data/anomalies
# SFTP_DIR=/mnt/recon-data/incoming_sftp
#
# render.yaml at the repo root applies all of the above for a Render web
# service with a 1 GB disk at /var/data. For the frontend build on Vercel set
# API_BASE_URL to the deployed API's URL; frontend/scripts/generate-env.mjs
# reads it from the environment when there is no .env file.

# -----------------------------------------------------------------------------
# (Optional) direct LLM provider keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
