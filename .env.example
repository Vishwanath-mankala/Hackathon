# =============================================================================
# Bank Reconciliation Console & Agentic Pipeline Configuration (TEMPLATE)
# Copy this file to .env and fill in your actual access tokens.
# =============================================================================

# Server Configuration
DEBUG=true
PORT=8000
HOST=0.0.0.0

# =============================================================================
# CrewAI / External Multi-Agent Platform API Configuration
# =============================================================================
CREWAI_ENABLED=false
# 1. Agent Execution Submission URL (POST multipart binary CSV)
CREWAI_API_URL=https://int-ai.aava.ai/agents/execute/agent-executions

# 2. Agent Execution Response Retrieval URL (GET ?execution_id=...)
CREWAI_RETRIEVAL_URL=https://int-ai.aava.ai/agents/execute/history/execution

# 3. Access Token / Bearer JWT
CREWAI_API_KEY=your_jwt_access_token_here

# 4. Default / Fallback Agent ID
CREWAI_AGENT_ID=56800

# =============================================================================
# Multi-Agent Specialized Role IDs
# =============================================================================
# Agent 1: Stage 4 Anomaly Classification & Severity Scoring (Risk Analytics)
CREWAI_AGENT_ANOMALY_ID=56800

# Agent 2: Stage 7 SLA Prediction & Urgency Classification (SLA Compliance)
CREWAI_AGENT_SLA_ID=55551

# Agent 3: Stage 6 Reconciliation & Exception Verification (Exception Management)
CREWAI_AGENT_RECON_ID=56797

# Agent 4: Stage 2 Ingestion & Financial Data Extraction (Data Extraction)
CREWAI_AGENT_EXTRACTION_ID=56231

# Agent 5: Frontend Architecture & Collab Orchestrator
CREWAI_AGENT_COLLAB_ID=7723

CREWAI_WORKFLOW_ID=reconciliation-multiagent-flow
CREWAI_TIMEOUT_SECONDS=60.0

# =============================================================================
# Pipeline Automation
# =============================================================================
# Fire the Stage 4 / 6 / 7 agents automatically as their input artefacts are
# produced. Set to false to run the deterministic pipeline only; the console can
# still dispatch an agent manually per stage.
AUTO_AGENT_DISPATCH=true

# Ingest every statement waiting in incoming_sftp/ when the API starts
# (ARCHITECTURE.md Stage 1 automated directory polling).
SFTP_AUTO_INGEST=true

# =============================================================================
# (Optional) Direct LLM Provider Keys
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
